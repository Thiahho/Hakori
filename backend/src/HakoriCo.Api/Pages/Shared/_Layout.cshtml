<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Hakori Admin</title>
    <style>
        :root { color-scheme: light; }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, Segoe UI, Arial, sans-serif;
            background: #f5f4f1;
            color: #14140f;
        }
        header.topbar {
            background: #14140f;
            color: #efeee9;
            padding: 14px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        header.topbar a { color: #efeee9; text-decoration: none; }
        header.topbar .brand { font-weight: 700; letter-spacing: 1px; text-transform: uppercase; font-size: 13px; }
        nav.tabs { display: flex; gap: 4px; padding: 0 24px; background: #1c1b17; }
        nav.tabs a {
            display: inline-block;
            padding: 10px 14px;
            color: rgba(239,238,233,0.7);
            text-decoration: none;
            font-size: 13px;
        }
        nav.tabs a.active { color: #efeee9; border-bottom: 2px solid #7c2222; }
        main { padding: 24px; max-width: 1000px; margin: 0 auto; }
        table { width: 100%; border-collapse: collapse; background: #fff; }
        th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid #e5e3dd; font-size: 14px; }
        th { background: #efeee9; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
        form.inline { display: inline; }
        input, select { padding: 6px 8px; border: 1px solid #ccc8bd; border-radius: 3px; font-size: 14px; }
        input[type=number] { width: 70px; }
        button, .btn {
            background: #14140f; color: #efeee9; border: none; padding: 8px 14px;
            border-radius: 3px; cursor: pointer; font-size: 13px; text-decoration: none; display: inline-block;
        }
        button:hover, .btn:hover { background: #2a2a20; }
        .btn.secondary { background: transparent; color: #14140f; border: 1px solid #ccc8bd; }
        .badge { padding: 2px 8px; border-radius: 12px; font-size: 11px; text-transform: uppercase; }
        .badge.Paid { background: #e3f2e3; color: #256029; }
        .badge.PendingPayment { background: #fdf3d8; color: #8a6d1a; }
        .badge.Cancelled, .badge.Expired { background: #fbe4e4; color: #8a2323; }
        .badge.Created { background: #e5e3dd; color: #444; }
        .alert { padding: 10px 14px; border-radius: 4px; margin-bottom: 16px; font-size: 14px; }
        .alert.success { background: #e3f2e3; color: #256029; }
        .alert.error { background: #fbe4e4; color: #8a2323; }
        .card { background: #fff; padding: 20px; border-radius: 6px; margin-bottom: 16px; }
        label { display: block; font-size: 12px; text-transform: uppercase; letter-spacing: 0.5px; color: #666; margin-bottom: 4px; }
        .field { margin-bottom: 14px; }
    </style>
</head>
<body>
    <header class="topbar">
        <a class="brand" href="/admin/products">Hakori · Admin</a>
        @if (User.Identity?.IsAuthenticated == true)
        {
            <form method="post" action="/admin/logout">
                <button type="submit">Cerrar sesión</button>
            </form>
        }
    </header>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="tabs">
            <a href="/admin/products">Productos</a>
            <a href="/admin/orders">Órdenes</a>
            <a href="/admin/subscribers">Suscriptores</a>
        </nav>
    }
    <main>
        @RenderBody()
    </main>
</body>
</html>
