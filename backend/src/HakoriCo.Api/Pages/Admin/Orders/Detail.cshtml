@page "/Admin/Orders/{orderNumber}"
@model HakoriCo.Api.Pages.Admin.Orders.DetailModel
@{
    ViewData["Title"] = Model.Order?.OrderNumber;
}
<h1>@Model.Order?.OrderNumber <span class="badge @Model.Order?.Status">@Model.Order?.Status</span></h1>

<div class="card">
    <p><strong>Email:</strong> @Model.Order?.Email</p>
    <p><strong>Envío:</strong> @Model.Order?.ShippingName — @Model.Order?.ShippingAddress, @Model.Order?.ShippingCity (@Model.Order?.ShippingPostalCode)</p>
    <p><strong>Teléfono:</strong> @Model.Order?.ShippingPhone</p>
    <p><strong>Creada:</strong> @Model.Order?.CreatedAt.ToLocalTime().ToString("g")</p>
    @if (Model.Order?.PaidAt is not null)
    {
        <p><strong>Pagada:</strong> @Model.Order.PaidAt.Value.ToLocalTime().ToString("g")</p>
    }
    <p><strong>Preferencia MP:</strong> @(Model.Order?.MercadoPagoPreferenceId ?? "—")</p>
    <p><strong>Pago MP:</strong> @(Model.Order?.MercadoPagoPaymentId ?? "—")</p>
</div>

<div class="card">
    <table>
        <thead><tr><th>Producto</th><th>Talle</th><th>Precio</th><th>Cant.</th><th>Subtotal</th></tr></thead>
        <tbody>
        @foreach (var item in Model.Order?.Items ?? [])
        {
            <tr>
                <td>@item.ProductName</td>
                <td>@item.Size</td>
                <td>$@item.UnitPrice.ToString("N0")</td>
                <td>@item.Quantity</td>
                <td>$@((item.UnitPrice * item.Quantity).ToString("N0"))</td>
            </tr>
        }
        </tbody>
    </table>
    <p style="text-align:right;font-weight:600;margin-top:10px;">Total: $@Model.Order?.Total.ToString("N0")</p>
</div>

@if (Model.Order?.Status is HakoriCo.Api.Orders.OrderStatus.PendingPayment or HakoriCo.Api.Orders.OrderStatus.Created)
{
    <form class="inline" method="post" asp-page-handler="MarkPaid">
        <button type="submit">Marcar como pagada</button>
    </form>
    <form class="inline" method="post" asp-page-handler="Cancel">
        <button type="submit" class="btn secondary">Cancelar orden</button>
    </form>
}

<p><a class="btn secondary" href="/admin/orders">Volver</a></p>
