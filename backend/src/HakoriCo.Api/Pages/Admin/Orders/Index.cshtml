@page
@model HakoriCo.Api.Pages.Admin.Orders.IndexModel
@{
    ViewData["Title"] = "Órdenes";
}
<h1>Órdenes</h1>
<form method="get" style="margin-bottom:16px;">
    <label style="display:inline;">Estado:</label>
    <select name="Status" onchange="this.form.submit()">
        <option value="">Todos</option>
        @foreach (var status in Model.Statuses)
        {
            <option value="@status" selected="@(Model.Status == status.ToString())">@status</option>
        }
    </select>
</form>
<table>
    <thead>
        <tr>
            <th>Orden</th>
            <th>Email</th>
            <th>Estado</th>
            <th>Total</th>
            <th>Fecha</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var order in Model.Orders)
    {
        <tr>
            <td><a href="/admin/orders/@order.OrderNumber">@order.OrderNumber</a></td>
            <td>@order.Email</td>
            <td><span class="badge @order.Status">@order.Status</span></td>
            <td>$@order.Total.ToString("N0")</td>
            <td>@order.CreatedAt.ToLocalTime().ToString("g")</td>
        </tr>
    }
    </tbody>
</table>
