@page
@model HakoriCo.Api.Pages.Admin.Products.IndexModel
@{
    ViewData["Title"] = "Productos";
}
<h1>Productos</h1>
<table>
    <thead>
        <tr>
            <th>#</th>
            <th>Nombre</th>
            <th>Slug</th>
            <th>Precio</th>
            <th>Stock total</th>
            <th>Activo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var product in Model.Products)
    {
        <tr>
            <td>@product.Index</td>
            <td>@product.Name</td>
            <td>@product.Slug</td>
            <td>$@product.Price.ToString("N0")</td>
            <td>@Model.TotalStock(product)</td>
            <td>@(product.IsActive ? "Sí" : "No")</td>
            <td><a class="btn secondary" href="/admin/products/@product.Id">Editar</a></td>
        </tr>
    }
    </tbody>
</table>
