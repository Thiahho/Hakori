# Resend (https://resend.com) — server-side only, never expose with NEXT_PUBLIC_
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Verified sender. Until the domain is verified in Resend, use the
# sandbox sender (only delivers to the Resend account owner's inbox):
EMAIL_FROM="Hakori <onboarding@resend.dev>"

# Server-only: used in the welcome email to build absolute links back to
# the site. Not read anywhere client-side, so no NEXT_PUBLIC_ prefix.
SITE_URL=http://localhost:3000
